# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/rewebportal"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="900"       # 15 minutes in seconds
JWT_REFRESH_TTL="2592000"  # 30 days

# ── SMS / OTP (MSG91) ─────────────────────────────────────────
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-msg91-template-id"
MSG91_SENDER_ID="REWEBT"

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@rewebportal.in"

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID="your-cf-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="rewebportal-docs"
R2_PUBLIC_URL="https://docs.rewebportal.in"

# ── Frontend URL ──────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Port ──────────────────────────────────────────────────────
PORT=3001
