# ─────────────────────────────────────────────────────────────────────────────
# REwebPortal — Backend API Environment Variables
# Copy to .env (local dev) or configure in Railway (production)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"           # development | staging | production
PORT=3001

# ── Database ──────────────────────────────────────────────────
# Local dev: postgresql://postgres:postgres@localhost:5432/rewebportal_dev
# Production: from Supabase connection string (Transaction Mode via PgBouncer)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rewebportal_dev"

# ── Redis ─────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: from Upstash (rediss:// for TLS)
REDIS_URL="redis://localhost:6379"

# ── JWT — RS256 Asymmetric Keys ───────────────────────────────
# Generate: openssl genrsa -out private.pem 2048
#           openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM content here (use \n for newlines in single-line env vars)
# Local dev can use the simplified JWT_SECRET below
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL="900"       # seconds — 15 minutes
JWT_REFRESH_TTL="2592000"  # seconds — 30 days

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000"
# Production: "https://rewebportal.in,https://www.rewebportal.in,https://staging.rewebportal.in"

# ── File Storage — Cloudflare R2 ──────────────────────────────
# R2 is S3-compatible; use @aws-sdk/client-s3
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="rewebportal-files"
# Public CDN URL for public assets (builder logos, project images)
R2_PUBLIC_URL="https://files.rewebportal.in"
# R2 endpoint for SDK (format: https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ── Application-Layer Encryption ──────────────────────────────
# Used for Agreement to Sale PDFs (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 🔴 NEVER commit a real key. Rotate annually. Keep old key for decryption.
ENCRYPTION_KEY="your-64-char-hex-key-here-generate-with-crypto-randomBytes-32"

# ── SMS / OTP — MSG91 ─────────────────────────────────────────
# Register at https://msg91.com — India TRAI DLT registration required for production
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="REWEBT"

# DLT-registered template IDs (must match approved templates exactly)
MSG91_OTP_TEMPLATE_ID="your-otp-template-id"
MSG91_TEMPLATE_ID_OTP="your-otp-template-id"
MSG91_TEMPLATE_ID_VERIFICATION_APPROVED="your-template-id"
MSG91_TEMPLATE_ID_VERIFICATION_REJECTED="your-template-id"
MSG91_TEMPLATE_ID_GRIEVANCE_ACKNOWLEDGED="your-template-id"
MSG91_TEMPLATE_ID_GRIEVANCE_RESOLVED="your-template-id"
MSG91_TEMPLATE_ID_GRIEVANCE_ESCALATED="your-template-id"
MSG91_TEMPLATE_ID_RED_FLAG_ALERT="your-template-id"
MSG91_TEMPLATE_ID_RERA_UPDATE="your-template-id"
MSG91_TEMPLATE_ID_WHATSAPP_JOIN_REQUEST="your-template-id"

# ── Email — Resend ────────────────────────────────────────────
# Register at https://resend.com — verify domain rewebportal.in
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="REwebPortal <noreply@rewebportal.in>"

# ── Frontend URL ──────────────────────────────────────────────
# Used in CORS and email links
FRONTEND_URL="http://localhost:3000"
# Production: "https://rewebportal.in"

# ── Maps (optional — server-side map operations) ───────────────
# Frontend Mapbox token is in web/.env — this is for any server-side geo operations
MAPBOX_SECRET_TOKEN="sk.eyJ..."
